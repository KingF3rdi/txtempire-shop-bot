# Discord Bot (shop_bot_py)
DISCORD_TOKEN=dein-bot-token
GUILD_ID=deine-server-id

# Optional: Website-Shop API (Vouches sync, Katalog-Sync)
SHOP_API_URL=http://localhost:8000
BOT_API_KEY=gleicher-key-wie-backend
FRONTEND_URL=http://localhost:3000

# Scan-Limits / Premium-Preise (Shop-Währung; 1 Credit = 100000)
# SCAN_FREE_DAILY=1
# SCAN_PREMIUM_DAILY=15
# SCAN_PREMIUM_14_PRICE=500000
# SCAN_PREMIUM_30_PRICE=900000
# Optional Credits-Preis (sonst Preis/100000):
# SCAN_PREMIUM_14_CREDITS=5
# SCAN_PREMIUM_30_CREDITS=9
# Pro Server überschreibbar: /scanprices
# 30 Tage = unbegrenzte Scans; 14 Tage = SCAN_PREMIUM_DAILY/Tag

# Payback XP (/daily): +10 XP/Tag, ab 100 XP → 500000 Guthaben (= 5 Credits)
# PAYBACK_DAILY_XP=10
# PAYBACK_REWARD_XP=100
# PAYBACK_REWARD_CURRENCY=500000
# Kunden (Customer-Rolle) +20% Daily-XP → 12 XP
# PAYBACK_CUSTOMER_BONUS_PCT=20

# Creator-Code Provision (% vom Bestellpreis vor Code-Rabatt); /cc stats monatlich
# CREATOR_COMMISSION_PCT=10

# Invite-Rewards (automatisch Credits): 5→500k, 10→1.5m, 25→5m, 100→25m
# Bot braucht Recht „Einladungen verwalten“

# Minecraft Account-Link + Fabric Chat-Watcher Mod
# MC_API_HOST=0.0.0.0
# MC_API_PORT=8765
MC_API_KEY=langer-zufalls-secret
# MC_LINK_CODE_TTL_MINUTES=10
