{
	"schemaVersion": 1,
	"id": "txtempire-mc-watcher",
	"version": "${version}",
	"name": "TxTEmpire MC Watcher",
	"description": "Erkennt Link-Codes und Ingame-Zahlungen (Shop-Bot, Website) und stellt optional das eigene Inventar für Duel Invsee bereit.",
	"authors": ["TxTEmpire"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.txtempire.mcwatcher.McWatcherClient"
		]
	},
	"mixins": [
		{
			"config": "txtempire-mc-watcher.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
